logs/
reports/
allure-results/
allure-report/
.coverage
.coverage.*
coverage.xml
htmlcov/

# pre-commit cache
.pre-commit-cache/

# IDE
.vscode/
.idea/
*.swp

# Runtime databases and operating-system metadata
*.db
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
.DS_Store
Thumbs.db
