# Runtime build context: deny by default and allow required inputs only.
*

!requirements.txt
!LICENSE
!pytest.ini
!pytest-offline.ini
!pyproject.toml
!conftest.py

!config/
!config/**/
!config/**/*.py
!src/
!src/**/
!src/**/*.py
!tests/
!tests/**/
!tests/**/*.py
!fixtures/
!fixtures/**/
!fixtures/**/*.json
!fixtures/**/*.jsonl
!scripts/
!scripts/*.py

# Generated files never belong in the source context.
**/__pycache__/
**/*.pyc
**/*.pyo
